# LINE Login channel credentials (LINE Developers Console > your channel > Basic settings)
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# Random secret used to sign/encrypt session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# Canonical deployment URL (avoids relying on header-based auto-detection).
# NEXTAUTH_URL=https://opd-ortho-skh.vercel.app
