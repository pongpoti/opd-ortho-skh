# Provided automatically when the Neon integration is connected to this
# project in Vercel (Storage tab). For local dev, copy this file to .env.local
# and paste the connection string from the Neon dashboard.
DATABASE_URL=

# Auth.js session/JWT encryption secret. Generate with:
#   npx auth secret
# or: openssl rand -base64 32
AUTH_SECRET=

# The LINE Login channel ID from https://developers.line.biz/console/.
# Used server-side to verify LIFF ID tokens via LINE's /oauth2/v2.1/verify
# endpoint -- must match the channel the LIFF app below was added to.
LINE_CLIENT_ID=

# The LIFF app ID (same console, LIFF tab). Its numeric prefix (before the
# "-") must equal LINE_CLIENT_ID above. Public: read by the LIFF SDK
# client-side to initialize the login flow.
NEXT_PUBLIC_LIFF_ID=

# Messaging API long-lived channel access token (same console, Messaging API
# channel linked to the LIFF / Login setup). Required to push the duty-schedule
# print PNG back to the user in LINE chat. Also used by scripts/line for the
# rich menu deploy. Without this, print still renders but send-to-chat fails.
LINE_CHANNEL_ACCESS_TOKEN=

# Telegram Bot API token from @BotFather. Used to push an admin alert when a
# new user completes /register. Pair with TELEGRAM_CHAT_ID (your user id, or a
# group/supergroup id). Get the chat id by messaging the bot, then calling
# getUpdates: https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
