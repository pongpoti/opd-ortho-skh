# Provided automatically when the Neon integration is connected to this
# project in Vercel (Storage tab). For local dev, copy this file to .env.local
# and paste the connection string from the Neon dashboard.
DATABASE_URL=

# Auth.js session/JWT encryption secret. Generate with:
#   npx auth secret
# or: openssl rand -base64 32
AUTH_SECRET=

# From a LINE Login channel at https://developers.line.biz/console/.
# Set the channel's callback URL to:
#   http://localhost:3000/api/auth/callback/line       (local dev)
#   https://<your-vercel-domain>/api/auth/callback/line (production)
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
